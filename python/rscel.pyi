import datetime
from typing import Any, Callable, Tuple

CelBasicType = int | float | str | bool | None
CelArrayType = list[CelBasicType | "CelArrayType" | "CelDict"]
CelDict = dict[str, "CelValue"]
CelValue = CelDict | CelArrayType | CelBasicType

CelCallable = Callable[[*Tuple[CelValue, ...]], CelValue]

CelBinding = dict[str, CelValue | CelCallable | Any]

class InterpRuntime:
    """Per-execution runtime state. `start_time` is what `now()` returns during a run."""

    def __init__(self, start_time: datetime.datetime | None = None):
        """Start at `start_time`, or now if omitted. Naive datetimes are local time."""
        ...

    @staticmethod
    def from_ns(ns: int) -> "InterpRuntime":
        """Create from nanoseconds since the Unix epoch, for exact replay."""
        ...

    @property
    def start_time(self) -> datetime.datetime:
        """Timezone-aware UTC start time (microsecond precision)."""
        ...

    @property
    def start_time_ns(self) -> int:
        """Start time as nanoseconds since the Unix epoch (full precision)."""
        ...

def eval(
    prog: str, binding: CelBinding, *, runtime: InterpRuntime | None = None
) -> CelValue: ...

class CelProgram:
    def __init__(self): ...
    def add_source(self, source: str): ...
    def add_serialized_json(self, source: str): ...
    def serialize_to_json(self) -> str: ...
    def details_json(self) -> str: ...

class BindContext:
    def __init__(self): ...
    def bind_param(self, name: str, val: CelValue): ...
    def bind_func(self, name: str, val: Callable[[Any, Any]]): ...
    def bind(self, name: str, val: Any): ...

class CelContext:
    def __init__(self): ...
    def add_program_string(self, name: str, source: str): ...
    def add_program(self, name: str, prog: "CelProgram"): ...
    def exec(
        self, name: str, bindings: BindContext, *, runtime: InterpRuntime | None = None
    ) -> CelValue: ...
